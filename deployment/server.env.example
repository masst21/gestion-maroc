# Copy outside the program folder as server.env and restrict filesystem access.
# Replace all placeholders before running. Never share this file.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
PORT=3010
# Keep loopback behind a TLS reverse proxy. Do not expose PostgreSQL.
HOSTNAME=127.0.0.1
DASHBOARD_MET_TERMS_ACCEPTED=false
