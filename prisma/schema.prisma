
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  ice       String?
  ifNumber  String?
  currency  String   @default("MAD")
  vatRate   Float    @default(20)
  logoUrl   String?
  createdAt DateTime @default(now())

  users        User[]
  articles     Article[]
  clients      Client[]
  sales        Sale[]
  suppliers    Supplier[]
  purchases    Purchase[]
  currencies Currency[]
  cashSessions CashSession[]
   expenses    Expense[]
    quotes     Quote[]
}

model User {
  id        String   @id @default(cuid())
  storeId   String
  email     String   @unique
  password  String
  fullName  String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
}

model Article {
  id            String   @id @default(cuid())
  storeId       String
  reference     String
  barcode       String?
  name          String
  nameAr        String?
  category      String?
  purchasePrice Float    @default(0)
  salePriceHt   Float    @default(0)
  vatRate       Float    @default(20)
  stockQty      Float    @default(0)
  stockMin      Float    @default(0)
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  store         Store         @relation(fields: [storeId], references: [id])
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([storeId, reference])
}

model Client {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  phone       String?
  email       String?
  ice         String?
  creditLimit Float    @default(0)
  balance     Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  store Store  @relation(fields: [storeId], references: [id])
  sales Sale[]
  quotes Quote[]
}

model Sale {
  id            String   @id @default(cuid())
  storeId       String
  clientId      String?
  invoiceNo     String   @unique
  saleDate      DateTime @default(now())
  subtotalHt    Float    @default(0)
  vatTotal      Float    @default(0)
  totalTtc      Float    @default(0)
  paidAmount    Float    @default(0)
  dueAmount     Float    @default(0)
  paymentStatus String   @default("paid")
paymentMethod String   @default("cash") // NOUVEAU : cash, card, bank
  saleType      String   @default("cash")
  userId        String?
  createdAt     DateTime @default(now())

  store  Store      @relation(fields: [storeId], references: [id])
  client Client?    @relation(fields: [clientId], references: [id])
  items  SaleItem[]
}

model SaleItem {
  id           String @id @default(cuid())
  saleId       String
  articleId    String
  quantity     Float
  unitPriceHt  Float
  vatRate      Float
  lineTotalHt  Float
  lineTotalTtc Float

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  phone     String?
  ice       String?
  createdAt DateTime @default(now())

  store     Store      @relation(fields: [storeId], references: [id])
  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(cuid())
  storeId     String
  supplierId  String
  totalAmount Float
  createdAt   DateTime @default(now())

  store    Store          @relation(fields: [storeId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]
}

model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String
  articleId  String
  quantity   Float
  unitCost   Float

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  article  Article  @relation(fields: [articleId], references: [id])
}

model CashSession {
  id              String    @id @default(cuid())
  storeId         String
  openingBalance  Float
  closingBalance  Float?
  expectedBalance Float?
  difference      Float?
  status          String    @default("open")
  openedAt        DateTime  @default(now())
  closedAt        DateTime?

  store     Store          @relation(fields: [storeId], references: [id])
  movements CashMovement[]
}

model CashMovement {
  id        String      @id @default(cuid())
  sessionId String
  type      String
  amount    Float
  reason    String
  createdAt DateTime    @default(now())

  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
model Expense {
  id            String   @id @default(cuid())
  storeId       String
  category      String   // Loyer, Salaires, Factures, Divers...
  description   String
  amount        Float
  paymentMethod String   @default("cash") // cash, card, bank
  date          DateTime @default(now())

  store         Store    @relation(fields: [storeId], references: [id])
}

model Quote {
  id         String      @id @default(cuid())
  storeId    String
  clientId   String?
  quoteNo    String      @unique
  date       DateTime    @default(now())
  validUntil DateTime?
  status     String      @default("draft") // draft, sent, accepted, rejected
  totalTtc   Float       @default(0)
  notes      String?

  store      Store       @relation(fields: [storeId], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id])
  items      QuoteItem[]
}

model Currency {
  id       String @id @default(cuid())
  storeId  String
  code     String // EUR, USD, GBP
  name     String // Euro, Dollar
  rate     Float  // Combien de MAD vaut 1 unité de cette devise
  isActive Boolean @default(true)
  store    Store  @relation(fields: [storeId], references: [id])
}

model QuoteItem {
  id           String  @id @default(cuid())
  quoteId      String
  description  String
  quantity     Float
  unitPriceHt  Float
  vatRate      Float
  lineTotalTtc Float

  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}